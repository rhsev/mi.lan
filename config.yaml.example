# Milan Configuration
# Copy to config.yaml and adjust IPs

milan:
  # Agent name claimed at Dylan's /whoami?name= (see "Identity check" in the
  # README). Default: the machine's LocalHostName, lower-cased ("Mini" → mini).
  # Set it only where config.yaml is machine-local, e.g. on a VPS: a config
  # synced between two Macs has to stay identical, and one name cannot fit both.
  # name: mini

  port: 8080

  # IPs allowed to trigger scripts (e.g. Dylan master)
  # Localhost is always allowed
  # Wildcards supported: "192.168.1.*"
  allowed_ips:
    - "192.168.1.*"       # Local subnet
    # - "192.168.2.*"     # Thunderbolt bridge between two Macs (direct cable).
                          # A machine reached over the bridge arrives with a
                          # source address from that subnet and is rejected
                          # with 403 unless it is listed here. Needed on the
                          # MacBook since 2026-09-16, when Wi-Fi went away and
                          # only the cable was left.
    # - "100.64.1.5"      # Tailscale IP

  scripts_dir: "./scripts"

  # Listen on one address instead of all interfaces (default: all). On a
  # machine with a public address this is the difference between "protected
  # by the firewall" and "not listening there at all".
  # bind: "100.64.1.5"

  # Per-script HMAC secrets (GitHub's webhook scheme). A script listed here
  # answers 403 unless the caller signs the raw request body:
  #   X-Hub-Signature-256: sha256=<hex hmac-sha256 of the body>
  # Scripts without an entry stay open — opt-in, per endpoint.
  # secrets:
  #   deploy: "long-random-string"

  # Environment for scripts, on top of milan's own (see "Script environment"
  # in the README). A service manager starts milan with a sparse environment;
  # this makes scripts see the same thing whether milan runs as a service or by
  # hand. "~" expands to the home directory. Without a locale anywhere, milan
  # adds LANG=en_US.UTF-8 (macOS) or C.UTF-8 by itself.
  # script_env:
  #   path_prepend: [~/bin]
  #   vars:
  #     GRUBBER_NOTES: ~/Notes
  #     REGISTER_BIN: ~/bin/register
